{
  "name": "main: require CI",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "Rust checks", "integration_id": 15368 },
          { "context": "Deterministic replay acceptance", "integration_id": 15368 },
          { "context": "Security audit", "integration_id": 15368 },
          { "context": "Python reference vectors", "integration_id": 15368 },
          { "context": "Fuzz boc_parser", "integration_id": 15368 },
          { "context": "Fuzz tvm_execution", "integration_id": 15368 },
          { "context": "Fuzz block_header", "integration_id": 15368 },
          { "context": "site-and-docs", "integration_id": 15368 },
          { "context": "Cargo Deny", "integration_id": 15368 },
          { "context": "Rust hygiene", "integration_id": 15368 },
          { "context": "TruffleHog", "integration_id": 15368 },
          { "context": "Version consistency", "integration_id": 15368 },
          { "context": "Dependency Review", "integration_id": 15368 }
        ]
      }
    }
  ]
}
